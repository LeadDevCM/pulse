# Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telnyx
# SMS_DELIVERY_MODE=manual skips Telnyx and shows the survey link/QR to the sender
# (use while the toll-free number is pending verification, or for demos)
SMS_DELIVERY_MODE=telnyx   # telnyx | sendblue | manual
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Telnyx portal → Account Settings → Keys & Credentials → Public Key (base64). Required for webhooks.
TELNYX_PUBLIC_KEY=

# Sendblue (used when SMS_DELIVERY_MODE=sendblue)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=            # your Sendblue line, E.164 (required on free plan)
SENDBLUE_WEBHOOK_SECRET=         # random string; webhook URL is /api/sms/sendblue?secret=<this>

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_IV_LENGTH=16

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# n8n Webhook
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SURVEY_LINK_EXPIRY_HOURS=48
AUTO_PURGE_DAYS=90
AUDIT_LOG_RETENTION_YEARS=6
