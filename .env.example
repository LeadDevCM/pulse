# Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Twilio (default provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # toll-free number, E.164 — or use a Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=

# Telnyx
SMS_DELIVERY_MODE=twilio   # twilio | telnyx | sendblue | webhook
# true = first text to a client is a YES/STOP consent prompt; survey sends on YES
SMS_DOUBLE_OPT_IN=false
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Telnyx portal → Account Settings → Keys & Credentials → Public Key (base64). Required for webhooks.
TELNYX_PUBLIC_KEY=

# Sendblue (used when SMS_DELIVERY_MODE=sendblue)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=            # your Sendblue line, E.164 (required on free plan)
SENDBLUE_WEBHOOK_SECRET=         # random string; webhook URL is /api/sms/sendblue?secret=<this>

# Generic webhook (used when SMS_DELIVERY_MODE=webhook, e.g. Zapier catch hook)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=              # optional; sent as X-Pulse-Secret

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_IV_LENGTH=16

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# n8n Webhook
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SURVEY_LINK_EXPIRY_HOURS=48
AUTO_PURGE_DAYS=90
AUDIT_LOG_RETENTION_YEARS=6
